# OpenAI-API-Key (nur Server)
OPENAI_API_KEY=
# Passwort fuer den Login der App
APP_PASSWORD=
# Geheimnis zum Signieren des Session-Cookies, mindestens 32 Zeichen (z. B. `openssl rand -hex 32`)
SESSION_SECRET=
# URL des ha-mcp-Servers (Streamable HTTP, inkl. geheimem Pfad)
HA_MCP_URL=http://192.168.1.10:8086/<geheimer-pfad>
# Optionaler Bearer-Token fuer ha-mcp selbst (den HA-Token haelt ha-mcp, nicht diese App)
HA_TOKEN=
# Kommaseparierte Entitaeten, die immer Bestaetigung brauchen
HA_CONFIRM_ENTITIES=
# Kommaseparierte Entitaeten, die steuerbar sind (leer = alle)
HA_ENTITY_ALLOWLIST=
# Backend-Modell fuer Delegation
LIVE_BACKEND_MODEL=gpt-6-luna
# Port des Servers
PORT=8080
# Token des Cloudflare Tunnels (Zero Trust → Networks → Tunnels → Docker-Befehl, Wert nach --token)
CLOUDFLARE_TUNNEL_TOKEN=
# Telefonie (optional, alle fuenf noetig): Twilio ruft die Nummer an und verbindet per SIP mit OpenAI
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio-Rufnummer als Absender, E.164 (+49...)
TWILIO_FROM=
# OpenAI-Projekt-ID (proj_...), Ziel der SIP-Adresse sip:<id>@sip.api.openai.com
OPENAI_PROJECT_ID=
# Signing-Secret des OpenAI-Webhooks (live.transport.incoming -> https://<domain>/webhooks/openai)
OPENAI_WEBHOOK_SECRET=
