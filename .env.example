# OpenAI-API-Key (nur Server)
OPENAI_API_KEY=
# Passwort fuer den Login der App
APP_PASSWORD=
# Geheimnis zum Signieren des Session-Cookies (langer Zufallsstring)
SESSION_SECRET=
# URL des Home-Assistant-MCP-Servers
HA_MCP_URL=http://homeassistant.local:8123/mcp_server/sse
# Long-Lived Access Token von Home Assistant (optional)
HA_TOKEN=
# Kommaseparierte Entitaeten, die immer Bestaetigung brauchen
HA_CONFIRM_ENTITIES=
# Kommaseparierte Entitaeten, die steuerbar sind (leer = alle)
HA_ENTITY_ALLOWLIST=
# Backend-Modell fuer Delegation
LIVE_BACKEND_MODEL=gpt-6-luna
# Port des Servers
PORT=8080
